   return NULL;
 }
 
+/* AIOStreams' optional structured response extension. Only literal booleans
+   in this stream's streamData.service object count; text, filenames, nested
+   headers and a neighbouring stream cannot supply cache evidence. */
+int stream_cache_metadata(const char *obj, const char *fim) {
+  const char *data, *df, *service, *sf, *value;
+  data = valorRaiz(obj, fim, "streamData");
+  if (!data || *data != '{' || !(df = js_fim(data)) || df > fim) return STREAM_CACHE_UNKNOWN;
+  service = valorRaiz(data, df, "service");
+  if (!service || *service != '{' || !(sf = js_fim(service)) || sf > df) return STREAM_CACHE_UNKNOWN;
+  value = valorRaiz(service, sf, "cached");
+  if (!value) return STREAM_CACHE_UNKNOWN;
+  int len = !strncmp(value, "true", 4) ? 4 : !strncmp(value, "false", 5) ? 5 : 0;
+  if (!len || value + len >= sf) return STREAM_CACHE_UNKNOWN;
+  const char *end = value + len;
+  while (end < sf && isspace((unsigned char)*end)) end++;
+  if (end >= sf || (*end != ',' && *end != '}')) return STREAM_CACHE_UNKNOWN;
+  return len == 4 ? STREAM_CACHE_CACHED : STREAM_CACHE_UNCACHED;
+}
+
 // Decimal integers only, parsed without double rounding. Numeric strings
 // are accepted for compatibility, but fractions/exponents/overflow are
 // unavailable for fit. Legacy display size remains separate below.
