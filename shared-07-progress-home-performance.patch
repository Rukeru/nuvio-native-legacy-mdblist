+void plrui_trilho(GfxRect r,float fraction,float cr,float cg,float cb,float a) { (void)r;(void)fraction;(void)cr;(void)cg;(void)cb;(void)a;graphCalls++;draws++; }
+void svd_avatar(GfxRect r,const char *url,const char *name,const char *id,float a) { (void)r;(void)url;(void)name;(void)id;(void)a;draws++; }
+void svd_ponto_vivo(float x,float y,float d,float border,float a,Uint32 t) { (void)x;(void)y;(void)d;(void)border;(void)a;(void)t;draws++; }
+static void seed(int count) {
+ vistoep_esquecer(); episodeCount=count;catalogRevision++;memset(&item,0,sizeof item);strcpy(item.imdb,"tt0096697");
+ for(int i=0;i<8000-count;i++)vistoep_definir("tt0000001",i/100+1,i%100+1,1);
+ for(int i=0;i<count;i++){memset(episodes+i,0,sizeof *episodes);episodes[i].temporada=i/24+1;episodes[i].episodio=i%24+1;vistoep_definir(item.imdb,episodes[i].temporada,episodes[i].episodio,i%2);}
+}
+int main(void) {
+ int sizes[]={72,888,1200};
+ for(int test=0;test<3;test++) {
+  seed(sizes[test]);vistoep_perf_reads=0;clock_t start=clock();
+  const TgDados *data=tgraf_dados(0);
+  double buildMs=1000.0*(clock()-start)/CLOCKS_PER_SEC;
+  unsigned long long reads=vistoep_perf_reads;
+  assert(data->total==sizes[test]&&data->vistos==sizes[test]/2);
+  for(int frame=0;frame<1000;frame++)assert(tgraf_dados(0)==data);
+  assert(vistoep_perf_reads==reads); /* stable frames already cached */
+  unsigned revision=data->revision;
+  vistoep_definir("tt0000001",1,1,0);
+  assert(tgraf_dados(0)->revision==revision); /* unrelated history */
+  vistoep_definir(item.imdb,1,1,0);assert(tgraf_dados(0)->revision==revision); /* no-op */
+  strcat(item.imdb,":1:1");assert(tgraf_dados(0)->revision==revision);strcpy(item.imdb,"tt0096697");
+  tgraf_reiniciar();tgraf_desenhar(data,48,200,1824,-1,1,1,1);
+  graphCalls=textCalls=draws=0;start=clock();
+  for(int frame=0;frame<1000;frame++)tgraf_desenhar(data,48,200,1824,-1,1,1,10000+frame*16);
+  printf("progress %d episodes/%d seasons: rebuild_reads=%llu build_ms=%.3f; stable_1000_frames bars=%d text_calls=%d draws=%d draw_cpu_ms=%.3f\n",sizes[test],data->n,reads,buildMs,graphCalls,textCalls,draws,1000.0*(clock()-start)/CLOCKS_PER_SEC);
+  unsigned bakes=progressCache.builds;assert(progressCache.valid);
+  tgraf_desenhar(data,48,190,1824,-1,1,.5f,30000);assert(progressCache.builds==bakes);
+  tgraf_desenhar(data,48,190,1824,2,1,1,30000);assert(progressCache.builds==bakes+1);
+  language++;tgraf_desenhar(data,48,190,1824,2,1,1,30000);assert(progressCache.builds==bakes+2);
+  font++;tgraf_desenhar(data,48,190,1824,2,1,1,30000);assert(progressCache.builds==bakes+3);
+  tgraf_desenhar(data,48,1200,1824,2,1,1,30000);assert(!progressCache.target.tex);
+  targetsAvailable=0;graphCalls=0;tgraf_desenhar(data,48,200,1824,2,1,1,30000);assert(graphCalls>0);targetsAvailable=1;
+  vistoep_definir(item.imdb,1,1,1);assert(tgraf_dados(0)->vistos==sizes[test]/2+1);
+ }
+ for(int seasons=1;seasons<=64;seasons++)for(int focus=0;focus<seasons;focus++) {
+  float widths[]={1024,1260,1824};
+  for(int w=0;w<3;w++){TgLayout layout=tgraf_layout(seasons,widths[w],focus);
+   assert(layout.count>0&&layout.first<=focus&&focus<layout.first+layout.count);
+   assert(layout.rowHeight>=46&&layout.columnWidth>=300);
+   assert(layout.count<=layout.rows*layout.columns&&layout.first+layout.count<=seasons);
+  }
+ }
+ tgraf_reiniciar();assert(!progressCache.target.tex);
+ vistoep_esquecer();puts("progress fixture: watched counts and stable-cache assertions passed");
+}
