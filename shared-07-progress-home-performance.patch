diff --git a/tests/ui_profile.sh b/tests/ui_profile.sh
new file mode 100644
index 0000000..ac950fb
--- /dev/null
+++ b/tests/ui_profile.sh
@@ -0,0 +1,26 @@
+#!/bin/bash
+# Actual GLES2 UI on Linux/Mesa. Counts are comparable; CPU is not a TV FPS prediction.
+set -euo pipefail
+fixture_root="$(cd "$(dirname "$0")/.." && pwd)"
+tree="$(cd "${1:-$fixture_root}" && pwd)"
+out="${2:-$tree/build/ui-profile}"
+mkdir -p "$out"
+out="$(cd "$out" && pwd)"
+temp=$(mktemp -d /tmp/nuvio-fluidez-perf-XXXXXX)
+trap 'rm -rf "$temp"' EXIT
+cd "$tree"
+sources=()
+for source in src/*.c src/dts/*.c; do
+  [ "$source" = src/main.c ] || sources+=("$source")
+done
+cc "${sources[@]}" "$fixture_root/tests/fluidez_perf.c" -Isrc \
+  -DNV_LINUX_DESKTOP -DNV_FLUIDEZ_PERF -DNV_SHOT_HOOKS -DNV_TRAKT_CLIENT_ID='"fixture-only"' \
+  -O2 -UNDEBUG -g $(pkg-config --cflags sdl2 SDL2_image SDL2_ttf glesv2 egl zlib) \
+  $(pkg-config --libs sdl2 SDL2_image SDL2_ttf glesv2 egl zlib) -pthread -ldl -lm -o "$temp/profile"
+for scene in moderna dinamica; do
+  mkdir -p "$temp/$scene"
+  LIBGL_ALWAYS_SOFTWARE=1 NV_HOME_ONLY=1 NV_CENARIO="$scene" \
+  NUVIO_DADOS="$temp/$scene" NUVIO_DUMP_FUNDO_DIR="$temp" \
+  NV_PROGRESS_SHOTS="$out/$scene" "$temp/profile" > "$out/home-$scene.txt" 2>&1
+  rg '^\[(moderna|dinamica|progress-render)\]' "$out/home-$scene.txt" || true
+done
diff --git a/tests/vistoep_threads.c b/tests/vistoep_threads.c
new file mode 100644
index 0000000..304efd3
--- /dev/null
+++ b/tests/vistoep_threads.c
@@ -0,0 +1,30 @@
+/* Network history writes may overlap UI reads. Exercise real pthreads. */
+#include "vistoep.h"
+#include <pthread.h>
+#include <assert.h>
+#include <stdio.h>
+static void *writeHistory(void *unused) {
+ (void)unused;
+ for(int i=0;i<12000;i++)vistoep_definir("tt0096697",i/100+1,i%100+1,i%2);
+ return NULL;
+}
+int main(void) {
+ pthread_t worker;
+ vistoep_esquecer();assert(pthread_create(&worker,NULL,writeHistory,NULL)==0);
+ VistoPar pairs[]={{1,1},{1,2},{50,10}};signed char states[3];int known;
+ for(int i=0;i<12000;i++){
+  vistoep_snapshot("tt0096697",pairs,3,states,&known);
+  for(int p=0;p<3;p++)assert(states[p]>=-1&&states[p]<=1);
+  int n=vistoep_n();assert(n>=0&&n<=8000);
+ }
+ assert(pthread_join(worker,NULL)==0);assert(vistoep_n()==8000);
+ assert(vistoep_estado("tt0096697:1:2",1,2)==1);
+ assert(vistoep_estado("tt0096697",1,1)==0);
+ unsigned r=vistoep_revisao_titulo("tt0096697");
+ vistoep_definir("tt0096697",1,1,0);assert(vistoep_revisao_titulo("tt0096697")==r);
+ vistoep_definir("tt0096697",1,1,1);assert(vistoep_revisao_titulo("tt0096697")!=r);
+ vistoep_esquecer();assert(vistoep_estado("tt0096697",1,1)==-1);
+ vistoep_definir("tt0096697",1,1,1);assert(vistoep_estado("tt0096697",1,1)==1);
+ puts("watched index: concurrent map growth, capacity, no-op revisions and reset passed");
+ vistoep_esquecer();
+}
