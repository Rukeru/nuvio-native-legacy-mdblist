diff --git a/src/mdblistlibrary.c b/src/mdblistlibrary.c
new file mode 100644
index 0000000000000000000000000000000000000000..621fd1bec6ee539ab94bff64ad2ce676462324c9
--- /dev/null
+++ b/src/mdblistlibrary.c
@@ -0,0 +1,182 @@
+#include "mdblistlibrary.h"
+#include "mdbformat.h"
+#include "mdblist.h"
+#include "mdblistscrobble.h"
+#include "rede.h"
+#include "js.h"
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#define WATCH_MAX 2000
+#define CW_MAX 128
+#define JOB_MAX 32
+typedef struct { unsigned serial,generation; int add,clear,state; char id[64],type[8]; } Job;
+static pthread_mutex_t lock=PTHREAD_MUTEX_INITIALIZER,network=PTHREAD_MUTEX_INITIALIZER;
+static MdbItem *watch;
+static int watchN,blocked,worker,noticeCode;
+static time_t watchAt,backoff;
+static unsigned generation,serial;
+static Job jobs[JOB_MAX];
+/* Code 1 means a confirmed write; 2 a failure with local state retained;
+   3 a failed read using any previous snapshot. No response text is surfaced. */
+static int credentials(char *key,unsigned *gen) {
+ int ok=mdblist_credencial(key,80,gen);
+ pthread_mutex_lock(&lock);
+ if(generation!=*gen) {
+  generation=*gen;watchN=0;watchAt=backoff=0;blocked=0;
+  free(watch);watch=NULL;
+  for(int i=0;i<JOB_MAX;i++)if(jobs[i].state==1)jobs[i].state=3;
+ }
+ pthread_mutex_unlock(&lock);return ok;
+}
+int mdb_library_connected(void) {char key[80];unsigned gen;int ok=credentials(key,&gen);memset(key,0,sizeof key);return ok;}
+static void problem(unsigned gen,int http,int retry,int writing) {
+ pthread_mutex_lock(&lock);
+ if(gen==generation) {
+  if(http==401||http==403)blocked=1;
+  time_t until=time(NULL)+(http==429?(retry>0?retry:3600):60);
+  if(until>backoff)backoff=until;
+  noticeCode=writing?2:3;
+ }
+ pthread_mutex_unlock(&lock);
+}
+static char *get(const char *path,const char *key,unsigned gen) {
+ char url[4096],auth[112];int http=0,retry=0;
+ snprintf(url,sizeof url,"https://api.mdblist.com%s",path);
+ snprintf(auth,sizeof auth,"Authorization: Bearer %s",key);
+ const char *headers[]={auth,"Accept: application/json",NULL};
+ char *body=rede_baixar_st_retry(url,15,headers,&http,&retry);
+ memset(auth,0,sizeof auth);
+ if(http<200||http>=300||!body){free(body);problem(gen,http,retry,0);return NULL;}
+ return body;
+}
+static int allowed(unsigned gen) {
+ pthread_mutex_lock(&lock);int ok=gen==generation&&!blocked&&time(NULL)>=backoff;pthread_mutex_unlock(&lock);return ok;
+}
+static int encode(char *dst,size_t n,const char *p) {
+ const char hex[]="0123456789ABCDEF";size_t used=0;
+ for(;*p;p++){unsigned char c=(unsigned char)*p;int plain=(c>='a'&&c<='z')||(c>='A'&&c<='Z')||(c>='0'&&c<='9')||c=='-'||c=='_'||c=='.'||c=='~';
+  if(used+(plain?1:3)>=n)return 0;if(plain)dst[used++]=(char)c;else{dst[used++]='%';dst[used++]=hex[c>>4];dst[used++]=hex[c&15];}}
+ dst[used]=0;return 1;
+}
+static int same(const MdbItem *a,const MdbItem *b) {return !strcmp(a->id,b->id)&&!strcmp(a->type,b->type)&&a->season==b->season&&a->episode==b->episode;}
+static void toCat(const MdbItem *item,CatItem *out) {
+ memset(out,0,sizeof *out);
+ if(item->episode)snprintf(out->imdb,sizeof out->imdb,"%s:%d:%d",item->id,item->season,item->episode);
+ else snprintf(out->imdb,sizeof out->imdb,"%s",item->id);
+ snprintf(out->tipo,sizeof out->tipo,"%s",item->type);
+ snprintf(out->titulo,sizeof out->titulo,"%s",item->title[0]?item->title:item->id);
+ snprintf(out->poster,sizeof out->poster,"%s",item->poster);
+ /* Existing metadata discovery supplies full cards when opened. IMDb's
+    public poster fallback follows the other providers' convention. */
+ if(!out->poster[0]&&!strncmp(item->id,"tt",2))snprintf(out->poster,sizeof out->poster,"https://images.metahub.space/poster/medium/%s/img",item->id);
+ out->temporada=item->season;out->episodio=item->episode;
+ out->progresso=(int)item->progress;out->retomadoMs=item->updated;
+ if(item->runtime>0)out->restanteMin=(int)(item->runtime*(100-item->progress)/100.0+0.5);
+}
+int mdb_library_watchlist(CatItem *out,int max) {
+ char key[80];unsigned gen;
+ if(!credentials(key,&gen)) {pthread_mutex_lock(&lock);noticeCode=3;pthread_mutex_unlock(&lock);return 0;}
+ if(!out) {
+  pthread_mutex_lock(&network);
+  pthread_mutex_lock(&lock);int fresh=watchAt&&time(NULL)-watchAt<300;pthread_mutex_unlock(&lock);
+  if(!fresh&&allowed(gen)) {
+   MdbItem *next=calloc(WATCH_MAX,sizeof *next),*page=calloc(200,sizeof *page);
+   char cursor[1024]="",previous[1024]="",escaped[3072],path[3400];int n=0,ok=next&&page;
+   for(int p=0;ok&&p<100;p++) {
+    if(!encode(escaped,sizeof escaped,cursor)){ok=0;break;}
+    snprintf(path,sizeof path,"/watchlist/items?limit=100&append_to_response=poster&cursor=%s",escaped);
+    char *body=get(path,key,gen);if(!body){ok=0;break;}
+    snprintf(previous,sizeof previous,"%s",cursor);
+    int count=mdb_parse_watchlist(body,page,200,cursor,sizeof cursor);free(body);
+    if(count<0){ok=0;break;}
+    for(int i=0;i<count;i++) {int duplicate=0;for(int j=0;j<n;j++)if(same(page+i,next+j)){duplicate=1;break;}
+     if(!duplicate){if(n==WATCH_MAX){ok=0;break;}next[n++]=page[i];}}
+    if(!ok||!cursor[0])break;
+    if(!strcmp(previous,cursor)||p==99){ok=0;break;}
+   }
+   pthread_mutex_lock(&lock);
+   if(ok&&gen==generation){free(watch);watch=next;next=NULL;watchN=n;watchAt=time(NULL);}
+   pthread_mutex_unlock(&lock);
+   if(!ok)problem(gen,0,0,0);
+   free(next);free(page);
+  }
+  pthread_mutex_unlock(&network);
+ }
+ memset(key,0,sizeof key);
+ pthread_mutex_lock(&lock);int n=gen==generation?watchN:0;
+ if(out){if(n>max)n=max;for(int i=0;i<n;i++){toCat(watch+i,out+i);out[i].naLista=1;}}
+ pthread_mutex_unlock(&lock);return n;
+}
+static int writeOK(const char *body,int clear,int add) {
+ const char *end=body?js_fim(body):NULL;if(!end||*body!='{')return 0;
+ if(clear) {const char *v=mdb_prop(body,end,"deleted");return v&&(!strncmp(v,"true",4)||!strncmp(v,"false",5));}
+ double missing=mdb_number(body,end,"not_found",-1);
+ if(missing!=0)return 0;
+ if(add)return mdb_number(body,end,"added",0)+mdb_number(body,end,"existing",0)>=1;
+ /* The remove route uses the documented result envelope as well. A
+    missing target is already removed; not_found is not silently accepted. */
+ return mdb_prop(body,end,"added")||mdb_prop(body,end,"existing")||mdb_prop(body,end,"removed");
+}
+static void *run(void *unused) {
+ (void)unused;
+ for(;;) {
+  Job job={0};int slot=-1;char key[80];unsigned gen;
+  int valid=credentials(key,&gen);
+  pthread_mutex_lock(&lock);
+  for(int i=0;i<JOB_MAX;i++)if(jobs[i].state==1&&(slot<0||jobs[i].serial<job.serial)){slot=i;job=jobs[i];}
+  if(slot<0){worker=0;pthread_mutex_unlock(&lock);memset(key,0,sizeof key);return NULL;}
+  pthread_mutex_unlock(&lock);
+  int ok=0,http=0;
+  pthread_mutex_lock(&network);
+  if(valid&&job.generation==gen&&allowed(gen)) {
+   char body[320],url[256],auth[112];
+   int formatted=job.clear?mdblist_corpo(body,sizeof body,job.id,0):mdb_watchlist_body(body,sizeof body,job.id,job.type);
+   if(formatted) {
+    snprintf(url,sizeof url,"https://api.mdblist.com%s",job.clear?"/scrobble/clear":job.add?"/watchlist/items/add":"/watchlist/items/remove");
+    snprintf(auth,sizeof auth,"Authorization: Bearer %s",key);
+    const char *headers[]={auth,"Content-Type: application/json",NULL};
+    char *reply=rede_postar_st(url,15,headers,body,&http);
+    ok=http>=200&&http<300&&writeOK(reply,job.clear,job.add);free(reply);memset(auth,0,sizeof auth);
+   }
+  }
+  memset(key,0,sizeof key);
+  if(!ok)problem(gen,http,0,1);
+  pthread_mutex_lock(&lock);
+  if(jobs[slot].serial==job.serial)jobs[slot].state=ok&&gen==generation?2:3;
+  if(gen==generation){watchAt=0;if(noticeCode!=2)noticeCode=ok?1:2;
+   if(ok&&!job.clear&&!job.add) {int w=0;for(int i=0;i<watchN;i++)if(strcmp(watch[i].id,job.id)||strcmp(watch[i].type,job.type))watch[w++]=watch[i];watchN=w;}
+  }
+  pthread_mutex_unlock(&lock);pthread_mutex_unlock(&network);
+ }
+}
+void mdb_library_tick(void) {
+ char key[80];unsigned gen;credentials(key,&gen);memset(key,0,sizeof key);
+ pthread_mutex_lock(&lock);int pending=0;for(int i=0;i<JOB_MAX;i++)if(jobs[i].state==1)pending=1;
+ if(pending&&!worker){pthread_t thread;worker=1;if(pthread_create(&thread,NULL,run,NULL)==0)pthread_detach(thread);else{worker=0;noticeCode=2;for(int i=0;i<JOB_MAX;i++)if(jobs[i].state==1)jobs[i].state=3;}}
+ pthread_mutex_unlock(&lock);
+}
+static unsigned queue(const char *id,const char *type,int add,int clear) {
+ char key[80],body[320];unsigned gen;int valid=credentials(key,&gen);memset(key,0,sizeof key);
+ int formatted=clear?mdblist_corpo(body,sizeof body,id,0):mdb_watchlist_body(body,sizeof body,id,type);
+ pthread_mutex_lock(&lock);int slot=-1;
+ for(int i=0;i<JOB_MAX;i++)if(jobs[i].state!=1&&(slot<0||jobs[i].serial<jobs[slot].serial))slot=i;
+ if(slot<0){noticeCode=2;pthread_mutex_unlock(&lock);return 0;}
+ Job *j=jobs+slot;memset(j,0,sizeof *j);j->serial=++serial;if(!serial)j->serial=++serial;
+ j->generation=gen;j->add=add;j->clear=clear;j->state=valid&&formatted?1:3;
+ snprintf(j->id,sizeof j->id,"%s",id?id:"");snprintf(j->type,sizeof j->type,"%s",type?type:"");
+ if(j->state==3)noticeCode=2;unsigned result=j->serial;pthread_mutex_unlock(&lock);mdb_library_tick();return result;
+}
+unsigned mdb_library_save(const char *id,const char *type,int add){return queue(id,type,add,0);}
+unsigned mdb_library_clear(const char *id){return queue(id,"",0,1);}
+int mdb_library_result(unsigned id) {
+ int state=3;pthread_mutex_lock(&lock);for(int i=0;i<JOB_MAX;i++)if(jobs[i].serial==id)state=jobs[i].state;pthread_mutex_unlock(&lock);return state;
+}
+const char *mdb_library_notice(int *refresh) {
+ pthread_mutex_lock(&lock);int code=noticeCode;noticeCode=0;pthread_mutex_unlock(&lock);
+ *refresh=code==1;
+ return code==1?"MDBList sync complete":code==2?"MDBList sync failed. Your local changes are safe. Try again when connected.":code==3?"MDBList could not refresh. Showing saved local or previous data.":NULL;
+}
