+ double after=1000.0*(clock()-begin)/CLOCKS_PER_SEC;
+ assert(calls==n&&v.count==last);assert(result);
+ printf("episode-index catalogue=%d season=%d frames=1000 before_reads=%d after_reads=%d before_cpu_ms=%.3f after_cpu_ms=%.3f memory_bytes=%zu\n",n,season,scans,calls,before,after,sizeof v);
