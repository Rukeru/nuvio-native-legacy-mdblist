+static void benchmark(int n,int last,int season){
+ EpisodeIndex v={0};volatile int result=0;calls=0;clock_t begin=clock();
+ for(int frame=0;frame<1000;frame++)for(int c=0;c<12;c++)result+=oldLookup(c,season,n);
