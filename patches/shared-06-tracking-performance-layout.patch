+ episode_index_prepare(&v,2,2,0,1,readSeason,NULL);assert(!v.count);
+ for(int left=60;left<=380;left+=20){int cols=vt_grid_columns(left,1480);assert(cols>=1&&cols<=5);assert(left+(cols-1)*264+248+8<=1480-24);}
