+  assert(!mdblist_channel_asset(NV_MDBLIST_DOWNLOAD_PREFIX "v2.0.3/libnuvio-2.0.3-mdblist-tpk-arm.so?download=1"));
+  puts("MDBList update channel asset isolation: PASS");
+  return 0;
+}
