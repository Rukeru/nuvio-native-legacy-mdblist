+  char text[160]; float px=c.x+BL_PAD,pw=c.w-BL_PAD*2,py=c.y+30;
+  snprintf(text,sizeof text,i18n("Impressão digital · E%d"),b->selEp);
+  TxtLinha title=txt_linha(TXT_G26B,text,245,245,245,255);
+  txt_desenhar_alpha(title,px,py,a); py+=title.h+14+30;
+  if (!usar || !dentro(b->sel)) return;
+  float gx=px+130,gw=pw-130,cw=(gw-BL_CEL_GAP*(nEps-1))/(float)nEps;
+  if (cw>90) cw=90;
+  snprintf(text,sizeof text,"%d",eps[b->sel].ep);
+  TxtLinha number=txt_linha(TXT_LOG_18B,text,245,245,245,255);
+  txt_desenhar_alpha(number,gx+(cw+BL_CEL_GAP)*b->sel+cw*.5f-number.w*.5f,py-30,a);
+  for (int e=0;e<SA_NEIXOS;e++) {
+    GfxRect q={gx+(cw+BL_CEL_GAP)*b->sel,py+(BL_CEL_H+BL_CEL_GAP)*e,cw,BL_CEL_H};
+    gfx_anel_fora(q,raioPx(q.w,q.h,9),2,2,1,1,1,.85f*a);
+  }
+  py+=(BL_CEL_H+BL_CEL_GAP)*SA_NEIXOS-BL_CEL_GAP+18;
+  if (eps[b->sel].tem) {
+    char q[32]; curto(q,sizeof q,eps[b->sel].watchers);
+    snprintf(text,sizeof text,i18n("E%d · %s pessoas marcaram no Trakt"),eps[b->sel].ep,q);
+  } else snprintf(text,sizeof text,i18n("E%d · sem dados de audiência"),eps[b->sel].ep);
+  TxtLinha l=txt_linha_corta(TXT_ILHA_SUB,text,210,214,222,255,pw);
+  txt_desenhar_alpha(l,px,py,a);
+  /* Selected-episode descriptions are cheap and independent of chart
+     geometry; retain the original best/most-discussed annotations. */
+  int mr=-1,mc=-1,com=0; const char *sup=NULL;
+  for (int i=0;i<nEps;i++) if (eps[i].tem) { com++; if(mr<0||serieaud_rever(i)>serieaud_rever(mr))mr=i; if(mc<0||eixoBruto(i,SA_CONV)>eixoBruto(mc,SA_CONV))mc=i; }
+  if(com>=3&&eps[b->sel].tem) { if(mr==b->sel&&mc==b->sel)sup="O mais revisto e o mais comentado da temporada."; else if(mr==b->sel)sup="O mais revisto da temporada."; else if(mc==b->sel)sup="O mais comentado da temporada."; }
+  if(!sup&&serieaud_melhor()==b->sel) { int count=0; for(int i=0;i<nEps;i++)count+=eps[i].nota>0; if(count>=3)sup="A maior nota da temporada."; }
+  if(sup)txt_desenhar_alpha(txt_linha_corta(TXT_ILHA_SUB,sup,150,153,162,255,pw),px,py+l.h+4,a);
+}
