+#ifndef NV_MDBLIST_WEBOS_H
+#define NV_MDBLIST_WEBOS_H
+#define NV_MDBLIST_WEBOS_API "https://api.github.com/repos/Rukeru/nuvio-native-legacy-mdblist/releases?per_page=100"
+/* Allocated single release object, or NULL. Caller frees it. */
+char *mdblist_webos_release(const char *json);
+int mdblist_webos_asset(const char *url);
+#endif
