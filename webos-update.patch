diff --git a/src/mdblistwebos.c b/src/mdblistwebos.c
new file mode 100644
index 0000000..e1ef9c2
--- /dev/null
+++ b/src/mdblistwebos.c
@@ -0,0 +1,102 @@
+#include "mdblistwebos.h"
+#include "mdblistchannel.h"
+#include <stdlib.h>
+#include <string.h>
+#include <ctype.h>
+#ifdef NV_WEBOS
+__attribute__((used)) const char nv_mdblist_webos_contract_v1[] = "nuvio-mdblist-webos/1";
+#endif
+
+static const char *ws(const char *p) { while (*p && isspace((unsigned char)*p)) p++; return p; }
+static const char *string_end(const char *p) {
+  if (*p++ != '"') return NULL;
+  while (*p) {
+    if ((unsigned char)*p < 32) return NULL;
+    if (*p == '"') return p + 1;
+    if (*p == '\\') { p++; if (!*p) return NULL; }
+    p++;
+  }
+  return NULL;
+}
+static const char *value_end(const char *p, int depth) {
+  const char *q;
+  if (depth > 64) return NULL;
+  p = ws(p);
+  if (*p == '"') return string_end(p);
+  if (*p == '{' || *p == '[') {
+    int object = *p == '{'; char close = object ? '}' : ']';
+    p = ws(p + 1);
+    if (*p == close) return p + 1;
+    for (;;) {
+      if (object) { p = string_end(p); if (!p || *(p = ws(p)) != ':') return NULL; p++; }
+      p = value_end(p, depth + 1); if (!p) return NULL;
+      p = ws(p); if (*p == close) return p + 1;
+      if (*p != ',') return NULL;
+      p = ws(p + 1);
+    }
+  }
+  q = p;
+  while (*q && !isspace((unsigned char)*q) && *q != ',' && *q != ']' && *q != '}') q++;
+  if (q == p) return NULL;
+  if ((q-p == 4 && !memcmp(p,"true",4)) || (q-p == 5 && !memcmp(p,"false",5)) ||
+      (q-p == 4 && !memcmp(p,"null",4))) return q;
+  { char *end; (void)strtod(p, &end); return end == q ? q : NULL; }
+}
+/* Root fields only: asset names and escaped release notes cannot impersonate a tag. */
+static const char *field(const char *p, const char *key, size_t *size) {
+  if (*p != '{') return NULL;
+  p = ws(p + 1);
+  while (*p && *p != '}') {
+    const char *e = string_end(p), *v, *end;
+    if (!e) return NULL;
+    v = ws(e); if (*v != ':') return NULL;
+    v = ws(v + 1); end = value_end(v,0); if (!end) return NULL;
+    if ((size_t)(e-p) == strlen(key)+2 && !memcmp(p+1,key,strlen(key))) {
+      *size = (size_t)(end-v); return v;
+    }
+    p = ws(end); if (*p != ',') break; p = ws(p+1);
+  }
+  return NULL;
+}
+static int version(const char *p, size_t n) {
+  size_t i; int dots = 0, digits = 0;
+  for (i=0;i<n;i++) {
+    if (p[i] >= '0' && p[i] <= '9') { if (++digits > 9) return 0; }
+    else if (p[i] == '.' && digits && dots < 2) { dots++; digits=0; }
+    else return 0;
+  }
+  return dots == 2 && digits;
+}
+char *mdblist_webos_release(const char *json) {
+  const char *p, *selected = NULL; size_t selected_size = 0;
+  if (!json || strlen(json) > 8*1024*1024) return NULL;
+  p = ws(json); if (*p++ != '[') return NULL; p = ws(p);
+  if (*p == ']') return NULL;
+  for (;;) {
+    const char *end = value_end(p,0), *tag, *draft, *pre;
+    size_t n=0, d=0, r=0;
+    if (!end || *p != '{') return NULL;
+    tag=field(p,"tag_name",&n); draft=field(p,"draft",&d); pre=field(p,"prerelease",&r);
+    if (!selected && tag && n>9 && !memcmp(tag,"\"webos-v",8) && tag[n-1]=='"' &&
+        version(tag+8,n-9) && draft && d==5 && !memcmp(draft,"false",5) &&
+        pre && r==5 && !memcmp(pre,"false",5)) { selected=p; selected_size=(size_t)(end-p); }
+    p=ws(end);
+    if (*p == ']') { if (*ws(p+1)) return NULL; break; }
+    if (*p != ',') return NULL;
+    p=ws(p+1);
+  }
+  if (selected) { char *out=malloc(selected_size+1); if(out) {memcpy(out,selected,selected_size);out[selected_size]=0;} return out; }
+  return NULL;
+}
+int mdblist_webos_asset(const char *url) {
+  const char *tag, *slash, *name;
+  const char *prefix=NV_MDBLIST_DOWNLOAD_PREFIX "webos-v";
+  const char *stem="space.nuvio.native.legacy_", *suffix="_mdblist_arm.ipk";
+  size_t n, v;
+  if (!url || strncmp(url,prefix,strlen(prefix))) return 0;
+  tag=url+strlen(prefix); slash=strchr(tag,'/'); if(!slash) return 0;
+  v=(size_t)(slash-tag); if(!version(tag,v)) return 0;
+  name=slash+1; n=strlen(name);
+  return n==strlen(stem)+v+strlen(suffix) && !memcmp(name,stem,strlen(stem)) &&
+      !memcmp(name+strlen(stem),tag,v) && !strcmp(name+strlen(stem)+v,suffix);
+}
