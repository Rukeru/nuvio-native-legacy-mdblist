+++ b/tests/mdblist_webos.c
@@ -0,0 +1,22 @@
+#include "mdblistwebos.h"
+#include <assert.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdio.h>
+#define RELEASE "{\"tag_name\":\"webos-v2.0.200001\",\"draft\":false,\"prerelease\":false,\"assets\":[]}"
+int main(void) {
+  char *r=mdblist_webos_release("[{\"tag_name\":\"v2.0.2.3\",\"draft\":false,\"prerelease\":false}," RELEASE "]");
+  assert(r && !strcmp(r,RELEASE)); free(r);
+  assert(!mdblist_webos_release(NULL)); assert(!mdblist_webos_release("[]"));
+  assert(!mdblist_webos_release("[" RELEASE));
+  assert(!mdblist_webos_release("[" RELEASE "]junk"));
+  assert(!mdblist_webos_release("[{\"tag_name\":\"webos-v2.0.200001\",\"draft\":true,\"prerelease\":false}]"));
+  assert(!mdblist_webos_release("[{\"tag_name\":\"webos-v2.0.200001\",\"draft\":false,\"prerelease\":true}]"));
+  assert(!mdblist_webos_release("[{\"assets\":[" RELEASE "],\"draft\":false,\"prerelease\":false}]"));
+  assert(!mdblist_webos_release("[{\"tag_name\":\"webos-v2.0.2.1\",\"draft\":false,\"prerelease\":false}]"));
+  assert(mdblist_webos_asset("https://github.com/Rukeru/nuvio-native-legacy-mdblist/releases/download/webos-v2.0.200001/space.nuvio.native.legacy_2.0.200001_mdblist_arm.ipk"));
+  assert(!mdblist_webos_asset("https://github.com/iqui27/nuvio-native-legacy/releases/download/v2.0.2/space.nuvio.native.legacy_2.0.2_arm.ipk"));
+  assert(!mdblist_webos_asset("https://github.com/Rukeru/nuvio-native-legacy-mdblist/releases/download/webos-v2.0.200001/space.nuvio.native.legacy_2.0.200002_mdblist_arm.ipk"));
+  assert(!mdblist_webos_asset("https://github.com/Rukeru/nuvio-native-legacy-mdblist/releases/download/webos-v2.0.200001/space.nuvio.native.legacy_2.0.200001_mdblist_arm.ipk?x=1"));
+  puts("webOS release filtering and trusted package selection: PASS"); return 0;
+}
