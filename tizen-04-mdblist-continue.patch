+++ b/tests/mdblistlibrary.c
@@ -0,0 +1,72 @@
+/* Controlled transport, clock, credentials, progress and scheduler. No real
+   account, network or graphics. Checks complete snapshots and local safety. */
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include "pthread.h"
+static void *(*scheduled)(void *);
+static int calls,http=200,retry=0,changeKey,postCalls;
+static unsigned account=1;
+static const char *keyValue="test_key";
+static const char *response="{\"movies\":[],\"shows\":[]}";
+static const char *second;
+static const char *postResponse="{\"added\":1,\"existing\":0,\"not_found\":0}";
+static time_t now=1791500000;
+static double localPos,localDuration;
+static time_t fake_time(time_t *out){if(out)*out=now;return now;}
+#ifdef _WIN32
+static struct tm *portable_gmtime(const time_t *at,struct tm *out){struct tm *r=gmtime(at);if(r)*out=*r;return r?out:NULL;}
+#define gmtime_r portable_gmtime
+#endif
+#define time fake_time
+#include "../src/mdblistlibrary.c"
+#undef time
+int pthread_mutex_lock(pthread_mutex_t *m){assert(!*m);*m=1;return 0;}
+int pthread_mutex_unlock(pthread_mutex_t *m){assert(*m);*m=0;return 0;}
+int pthread_create(pthread_t *t,const void *attr,void *(*f)(void *),void *arg){(void)attr;(void)arg;assert(!scheduled);scheduled=f;*t=1;return 0;}
+int pthread_detach(pthread_t t){(void)t;return 0;}
+static void drain(void){void *(*f)(void *)=scheduled;scheduled=NULL;if(f)f(NULL);}
+int mdblist_credencial(char *out,size_t n,unsigned *gen){snprintf(out,n,"%s",keyValue);*gen=account;return !!*keyValue;}
+char *rede_baixar_st_retry(const char *url,int timeout,const char *const *headers,int *status,int *after){
+ assert(!lock&&network);assert(timeout==15);assert(!strstr(url,"apikey="));assert(!strncmp(headers[0],"Authorization: Bearer ",22));
+ *status=http;*after=retry;calls++;
+ if(changeKey){changeKey=0;account++;mdb_library_tick();}
+ const char *value=second&&strstr(url,"cursor=page2")?second:response;
+ if(strstr(url,"/sync/playback"))value="[{\"type\":\"movie\",\"progress\":70,\"runtime\":90,\"movie\":{\"ids\":{\"imdb\":\"tt123\"}},\"paused_at\":\"2026-10-08T01:00:00Z\"}]";
+ if(strstr(url,"/upnext"))value="{\"items\":[],\"has_more\":false}";
+ if(strstr(url,"/sync/watched"))value="{\"movies\":[],\"episodes\":[]}";
+ return value?strdup(value):NULL;
+}
+char *rede_postar_st(const char *url,int timeout,const char *const *headers,const char *body,int *status){
+ assert(!lock&&network);assert(timeout==15);assert(strstr(headers[0],"Bearer"));assert(!strstr(url,keyValue));
+ if(strstr(url,"watchlist"))assert(strstr(body,"\"ids\""));
+ postCalls++;*status=http;return postResponse?strdup(postResponse):NULL;
+}
+void prog_chave(char *out,unsigned n,const char *id,int season,int ep){if(ep)snprintf(out,n,"%s_s%de%d",id,season,ep);else snprintf(out,n,"%s",id);}
+int prog_por_chave(const char *key,ProgRegistro *out){(void)key;memset(out,0,sizeof *out);out->posSeg=localPos;out->durSeg=localDuration;out->lastWatchedMs=1;return localDuration>0;}
+int ajustes_cw_concluido(void){return 90;}
+void cwo_marcar_estreia(const char *id,long long at){(void)id;(void)at;}
+static void reset(void){drain();account++;char key[80];unsigned gen;credentials(key,&gen);http=200;retry=calls=postCalls=changeKey=0;second=NULL;keyValue="test_key";noticeCode=0;localPos=localDuration=0;}
+int main(void){
+ CatItem *items=calloc(4,sizeof *items);assert(items);
+ reset();response="{\"movies\":[{\"ids\":{\"imdb\":\"tt123\"}}],\"pagination\":{\"next_cursor\":\"page2\"}}";
+ second="{\"movies\":[{\"ids\":{\"imdb\":\"tt123\"}}],\"shows\":[{\"ids\":{\"tmdb\":55}}]}";
+ assert(mdb_library_watchlist(NULL,0)==2&&calls==2);
+ assert(mdb_library_watchlist(items,4)==2&&items[0].naLista&&calls==2);
+ assert(mdb_library_watchlist(NULL,0)==2&&calls==2); /* TTL */
+ now+=301;http=500;assert(mdb_library_watchlist(NULL,0)==2&&calls==3); /* retain */
+ reset();http=429;retry=120;assert(mdb_library_watchlist(NULL,0)==0);int seen=calls;
+ now+=61;assert(mdb_library_watchlist(NULL,0)==0&&calls==seen);now+=60;assert(mdb_library_watchlist(NULL,0)==0&&calls>seen);
+ reset();http=401;assert(mdb_library_watchlist(NULL,0)==0);seen=calls;now+=5000;assert(mdb_library_watchlist(NULL,0)==0&&calls==seen);
+ reset();response="{\"movies\":[{\"ids\":{\"imdb\":\"tt123\"}}]}";changeKey=1;assert(mdb_library_watchlist(NULL,0)==0); /* discard old profile reply */
+ reset();unsigned job=mdb_library_save("tt123","movie",1);assert(job&&mdb_library_result(job)==1);drain();assert(mdb_library_result(job)==2&&postCalls==1);
+ reset();postResponse="{\"added\":0,\"existing\":0,\"not_found\":1}";job=mdb_library_save("tt123","movie",1);drain();assert(mdb_library_result(job)==3);
+ reset();postResponse="{\"added\":1,\"existing\":0,\"not_found\":0}";job=mdb_library_save("tt123","movie",1);account++;mdb_library_tick();drain();assert(mdb_library_result(job)==3&&postCalls==0);
+ reset();job=mdb_library_save("tmdb:t55","movie",1);assert(mdb_library_result(job)==3&&postCalls==0);
+ reset();localDuration=3600;localPos=1200;assert(mdb_library_continue(items,4)==1&&items[0].progresso==33&&items[0].retomadoMs==1&&calls==3);
+ localPos=3500;assert(mdb_library_continue(items,4)==0&&calls==3); /* completed local, unchanged cache */
+ reset();keyValue="";job=mdb_library_save("tt123","movie",1);assert(mdb_library_result(job)==3&&postCalls==0);
+ free(items);free(watch);puts("MDBList library: pagination/dedup, TTL, failure retention, 401/429, account isolation, write confirmation and precise local resume passed");return 0;
+}
