+  if(page[i].expires&&page[i].expires<=now)continue;
+  if(!page[i].updated)oldest=-1;
+  else if(oldest>=0&&(!oldest||page[i].updated<oldest))oldest=page[i].updated;
+  int at=-1;for(int j=0;j<count;j++)if(same(page+i,next+j)){at=j;break;}
+  if(at>=0){if(page[i].updated>next[at].updated)next[at]=page[i];continue;}
+  if(count==CW_MAX){free(page);return -1;}next[count++]=page[i];
+ }
+ for(int offset=0;offset<2000;offset+=100) {
+  char path[180];snprintf(path,sizeof path,"/upnext?limit=100&offset=%d&hide_unreleased=true&air_date_format=instant",offset);
+  body=get(path,key,gen);int more=0;int got=body?mdb_parse_next(body,page,512,&more):-1;free(body);
+  if(got<0){free(page);return -1;}
+  for(int i=0;i<got;i++) {
+   if(page[i].air&&page[i].air>now)continue;
+   int at=-1;for(int j=0;j<count;j++)if(!strcmp(page[i].id,next[j].id)&&!strcmp(page[i].type,next[j].type)){at=j;break;}
+   /* A paused show already has a concrete resume episode. Up Next must not
+      replace it merely because watched-history activity has a newer date. */
+   if(at>=0)continue;
+   if(count==CW_MAX){free(page);return -1;}next[count++]=page[i];
+  }
+  if(!more)break;
+  if(offset==1900){free(page);return -1;}
+ }
+ free(page);
+ if(!count)return 0;
+ char since[64]="",cursor[1024]="",previous[1024],escaped[3072],path[3500];
+ /* The oldest paused instant bounds the history query. Missing timestamps
+    require the bounded full-history fallback. History is ONLY a veto. */
+ if(oldest>0) {time_t seconds=(time_t)(oldest/1000);struct tm stamp;
+  if(gmtime_r(&seconds,&stamp))strftime(since,sizeof since,"&since=%Y-%m-%dT%H:%M:%SZ",&stamp);
+ }
+ for(int p=0;p<20;p++) {
+  if(!encode(escaped,sizeof escaped,cursor))return -1;
+  snprintf(path,sizeof path,"/sync/watched?limit=1000%s&cursor=%s",since,escaped);
+  body=get(path,key,gen);snprintf(previous,sizeof previous,"%s",cursor);
+  int filtered=body?mdb_filter_watched(body,next,count,cursor,sizeof cursor):-1;free(body);
+  if(filtered<0)return -1;count=filtered;
+  if(!cursor[0])break;
+  if(!strcmp(cursor,previous)||p==19)return -1;
+ }
+ return count;
+}
+int mdb_library_continue(CatItem *out,int max) {
+ char key[80];unsigned gen;
+ if(!credentials(key,&gen)){pthread_mutex_lock(&lock);noticeCode=3;pthread_mutex_unlock(&lock);return 0;}
+ pthread_mutex_lock(&network);
+ pthread_mutex_lock(&lock);int fresh=cwAt&&time(NULL)-cwAt<300;pthread_mutex_unlock(&lock);
+ if(!fresh&&allowed(gen)) {
+  MdbItem *next=calloc(CW_MAX,sizeof *next);int n=next?cwRead(next,key,gen):-1;
+  pthread_mutex_lock(&lock);
+  if(n>=0&&gen==generation){memcpy(cw,next,(size_t)n*sizeof *next);cwN=n;cwAt=time(NULL);}
+  pthread_mutex_unlock(&lock);free(next);
+  if(n<0)problem(gen,0,0,0);
+ }
+ pthread_mutex_unlock(&network);memset(key,0,sizeof key);
+ /* Copy compact data before consulting progress (a different mutex). No
+    reverse lock order, and no estimated seconds are written to disk. */
+ MdbItem *copy=calloc(CW_MAX,sizeof *copy);if(!copy)return 0;
+ pthread_mutex_lock(&lock);int n=gen==generation?cwN:0;memcpy(copy,cw,(size_t)n*sizeof *copy);pthread_mutex_unlock(&lock);
+ int w=0;
+ for(int i=0;i<n;i++) {
+  char progressKey[48];ProgRegistro local;
+  prog_chave(progressKey,sizeof progressKey,copy[i].id,copy[i].season,copy[i].episode);
+  if(prog_por_chave(progressKey,&local)&&mdb_resume_apply(copy+i,local.posSeg,local.durSeg,local.lastWatchedMs,ajustes_cw_concluido())<0)continue;
+  if(copy[i].expires&&copy[i].expires<=(long long)time(NULL)*1000)continue;
+  copy[w++]=copy[i];
+ }
+ n=w;
+ for(int i=1;i<n;i++){MdbItem value=copy[i];int j=i;while(j>0&&copy[j-1].updated<value.updated){copy[j]=copy[j-1];j--;}copy[j]=value;}
+ if(n>max)n=max;
+ for(int i=0;i<n;i++){toCat(copy+i,out+i);if(copy[i].next)cwo_marcar_estreia(out[i].imdb,copy[i].air?copy[i].air:CWO_SEM_DATA);}
+ free(copy);return n;
+}
+int mdb_library_next(const char *id) {
+ if(!id)return 0;char key[80];unsigned gen;if(!credentials(key,&gen))return 0;memset(key,0,sizeof key);
+ int found=0;pthread_mutex_lock(&lock);
+ for(int i=0;i<cwN&&!found;i++)if(cw[i].next){char compound[96];snprintf(compound,sizeof compound,"%s:%d:%d",cw[i].id,cw[i].season,cw[i].episode);found=!strcmp(id,compound);}
+ pthread_mutex_unlock(&lock);return found;
+}
